# Copy to .env.local to override.
#
# Local dev: leave as "/api" — the Vite dev server proxies it to
# http://localhost:8000 (see vite.config.js).
#
# Production (Vercel): set this to your deployed backend's API base, e.g.
#   VITE_API_BASE=https://eld-logger-api.onrender.com/api
# Vercel injects env vars at build time, so set it in the Vercel project
# settings (Environment Variables) before building.
VITE_API_BASE=/api
