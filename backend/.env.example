# Copy to .env and fill in. All values are optional for local dev.

# OpenRouteService API key (free: https://openrouteservice.org/dev/#/signup).
# If blank, the app falls back to keyless Nominatim + OSRM public endpoints.
ORS_API_KEY=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production only: trusted HTTPS origins for CSRF (your frontend URL)
CSRF_TRUSTED_ORIGINS=

# Database — leave blank to use local SQLite; set to a Postgres URL in production
# e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Home-terminal timezone used when drawing log sheets.
TERMINAL_TIMEZONE=America/Chicago
